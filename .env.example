# Supabase（在 supabase.com 建一个免费项目后填写）
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon-public-key
SUPABASE_SERVICE_ROLE_KEY=你的service_role_key

# 站长登录邮箱（仅这一个邮箱能进开发者模式）
OWNER_EMAIL=你的邮箱@example.com

# 站点信息（会显示在页面上）
NEXT_PUBLIC_SITE_NAME=未名集
NEXT_PUBLIC_PEN_NAME=未名
NEXT_PUBLIC_MOTTO_ZH=（可选）封面大字第二行，如：纸上法学
NEXT_PUBLIC_TAGLINE_ZH=（可选）首页标语，如：写法律、人心与时代，也写自己
NEXT_PUBLIC_GITHUB=LuYan723
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
